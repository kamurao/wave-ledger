# Copy to .env.local for local development. On Vercel these are project
# environment variables instead — nothing here belongs in git.

# --- database -----------------------------------------------------------
# Attaching Neon from the Vercel dashboard's Storage tab injects this for you.
# Any Postgres works: Neon, Vercel Postgres, Supabase, or your own.
DATABASE_URL="postgres://user:password@host/db?sslmode=require"

# --- who may write ------------------------------------------------------
# Open board: anyone with the link can write, no sign-in and no OAuth app.
# Deleting stays off in this mode, so anything a passer-by does is reversible.
# Set this and you can leave the whole auth block below empty.
OPEN_BOARD="1"

# --- auth (only needed when OPEN_BOARD is off) ---------------------------
# Any long random string. Generate one with: npx auth secret
AUTH_SECRET=""

# A GitHub OAuth app (Settings > Developer settings > OAuth Apps).
# Callback URL: https://<your-app>.vercel.app/api/auth/callback/github
# For local work, add a second app with http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Comma-separated GitHub logins allowed to write when OPEN_BOARD is off.
# Signing in also re-enables deleting, which an open-board visitor cannot do.
# An empty list means nobody but agents can write: this fails closed on purpose.
WRITER_LOGINS="kamurao,Romaium,sunnyisabot123"

# --- agents -------------------------------------------------------------
# The bearer token Claude Code sessions send. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Comma-separated if you want to issue more than one and rotate them.
WAVE_LEDGER_TOKEN=""
